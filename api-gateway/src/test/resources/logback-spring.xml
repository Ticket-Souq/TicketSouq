<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN:-%5p} [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework.cloud.gateway"     level="INFO"/>
    <logger name="org.springframework.cloud.loadbalancer" level="INFO"/>
    <logger name="org.springframework.security"          level="WARN"/>
    <logger name="com.netflix.eureka"                    level="WARN"/>
    <logger name="com.netflix.discovery"                 level="WARN"/>
    <logger name="io.micrometer"                         level="WARN"/>
    <logger name="org.hibernate.SQL"                     level="DEBUG"/>
    <logger name="org.hibernate.type.descriptor.sql"     level="WARN"/>

    <turboFilter class="org.ticketsouq.sharedmodule.logging.OutboxSqlTurboFilter"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
