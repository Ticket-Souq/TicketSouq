      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-event" },
          "rawSql": "SELECT e.title, e.status, SUM(s.capacity) as total_capacity, SUM(s.capacity - s.remaining_capacity) as sold, ROUND((SUM(s.capacity - s.remaining_capacity)::numeric / NULLIF(SUM(s.capacity), 0)) * 100, 1) as utilization_pct FROM events e JOIN sections s ON s.event_id = e.id WHERE e.status = 'ACTIVE' GROUP BY e.id, e.title, e.status ORDER BY utilization_pct DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Events by Capacity Utilization",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "title": 0,
              "status": 1,
              "total_capacity": 2,
              "sold": 3,
              "utilization_pct": 4
            },
            "renameByName": {
              "title": "Event",
              "status": "Status",
              "total_capacity": "Total Capacity",
              "sold": "Sold",
              "utilization_pct": "Utilization %"
            }
