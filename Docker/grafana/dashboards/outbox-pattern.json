        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(outbox_events_processed_total{application=~\"$application\", status=\"FAILED\"}[$__rate_interval])",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Retry Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "unit": "ops"
        },
