      "title": "Cache Hit Ratio",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${db}" },
          "rawSql": "SELECT\n  COALESCE(\n    round(100.0 * sum(blks_hit) / NULLIF(sum(blks_hit) + sum(blks_read), 0), 2),\n    100\n  ) AS \"Hit Ratio\",\n  now() AS \"time\"\nFROM pg_stat_database WHERE datname = current_database()",
          "format": "table",
          "refId": "A"
        }
      ]
