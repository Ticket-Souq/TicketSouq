{
  "uid": "sales-revenue",
  "title": "Sales & Revenue",
  "schemaVersion": 39,
  "tags": ["sales", "revenue", "payments", "business"],
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Event Management",
      "url": "/d/event-management/event-management",
      "type": "link",
      "icon": "external link",
      "targetBlank": true
    },
    {
      "title": "Saga Orchestrator",
      "url": "/d/saga-orchestrator/saga-orchestrator",
      "type": "link",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Revenue Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Total Revenue",
      "datasource": { "type": "postgres", "uid": "postgres-payment" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT COALESCE(SUM(amount), 0) as total FROM payment_model WHERE payment_status = 'SUCCESS'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tickets Sold (Total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "tickets_sold_total",
          "legendFormat": "Tickets Sold",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg Ticket Price",
      "datasource": { "type": "postgres", "uid": "postgres-ticket" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT COALESCE(AVG(price), 0) as avg_price FROM tickets WHERE reservation_status = 'ACTIVE'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "purple", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Payment Success Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(payments_total{status=\"SUCCESS\"}[$__rate_interval]) / (rate(payments_total{status=\"SUCCESS\"}[$__rate_interval]) + rate(payments_total{status=\"FAILED\"}[$__rate_interval])) * 100",
          "legendFormat": "Success Rate",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Revenue Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Revenue Over Time",
      "datasource": { "type": "postgres", "uid": "postgres-payment" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT date_trunc('day', created_at) as time, SUM(amount) as revenue FROM payment_model WHERE payment_status = 'SUCCESS' AND created_at > $__timeFrom() AND created_at < $__timeTo() GROUP BY 1 ORDER BY 1",
          "timeColumn": "time",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Revenue",
            "scaleDistribution": { "type": "linear" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tickets Sold Over Time",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tickets_sold_total[$__rate_interval])",
          "legendFormat": "Tickets Sold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Tickets",
            "scaleDistribution": { "type": "linear" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Payment Status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Payment Success Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(payments_total{status=\"SUCCESS\"}[$__rate_interval]) / (rate(payments_total{status=\"SUCCESS\"}[$__rate_interval]) + rate(payments_total{status=\"FAILED\"}[$__rate_interval])) * 100",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Payment Success vs Failed",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(payments_total{status=\"SUCCESS\"}[$__rate_interval])",
          "legendFormat": "Success"
        },
        {
          "refId": "B",
          "expr": "rate(payments_total{status=\"FAILED\"}[$__rate_interval])",
          "legendFormat": "Failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Payments/sec",
            "scaleDistribution": { "type": "linear" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Success" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Refund Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 17 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(payments_total{status=\"REFUNDED\"}[$__rate_interval])",
          "legendFormat": "Refund Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "gradientMode": "scheme",
            "showPoints": "never",
            "spanNulls": true,
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "Refunds/sec",
            "scaleDistribution": { "type": "linear" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Top Events by Revenue",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "table",
      "title": "Top Events by Revenue",
      "datasource": { "type": "postgres", "uid": "postgres-payment" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT p.reservationid, SUM(p.amount) as revenue FROM payment_model p WHERE p.payment_status = 'SUCCESS' GROUP BY p.reservationid ORDER BY revenue DESC LIMIT 20",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "revenue" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "revenue",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ],
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 39,
  "version": 1
}
